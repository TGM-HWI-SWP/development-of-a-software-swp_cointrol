# ======================================================
# CoinTrol – .gitignore
# HTL Wien XX | 4BHWII | SWP Projekt 2025
# ======================================================
# Ignoriert Build-Dateien, Cache, Umgebungen und vertrauliche Daten
# ======================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
__pypackages__/

# ---- Virtuelle Umgebung ----
.venv/
venv/
env/

# ---- Logs & Temporäre Dateien ----
*.log
*.tmp
*.bak
*.swp

# ---- IDEs & Editor ----
.vscode/
.settings/
.idea/
*.sublime-workspace
*.sublime-project

# ---- Build / Distribution ----
build/
dist/
*.egg-info/
*.spec                # PyInstaller build files

# ---- Betriebssystem ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Tests & Coverage ----
.pytest_cache/
.coverage
htmlcov/

# ---- Umgebungsvariablen & Secrets ----
.env
.env.local
.env.*.backup

# ---- Lokale Notizen oder Dateien ----
notes.txt
todo.txt